<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS everywhere, except the e2e receiver on the emulator's host loopback (http://10.0.2.2:8787).
     A phone build that uploads to a real server needs no cleartext at all: remove the domain-config. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
